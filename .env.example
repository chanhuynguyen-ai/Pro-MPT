# Local MVP demo uses SQLite so you can run quickly.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage provider.
# local = filesystem in ./storage/repository-assets
# s3 = S3 / Cloudflare R2 / MinIO compatible object storage
STORAGE_DRIVER="local"
STORAGE_ROOT_DIR="./storage/repository-assets"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="1"

# Optional remote OpenAI fallback for chat sandbox and Crow-Chat.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Optional local Ollama host. Defaults to Ollama running on your machine.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
