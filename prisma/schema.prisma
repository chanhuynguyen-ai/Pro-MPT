generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum CompatibilityTarget {
  ALL_MODELS
  CHATGPT
  CLAUDE
  CLAUDE_CODE
  GEMINI
}

enum RepositorySourceMode {
  MANUAL
  UPLOAD_BUNDLE
}

enum RepositoryKind {
  PROMPT_TEXT
  PROMPT_IMAGE
  SKILL
}

enum LlmProvider {
  GEMINI
  OPENAI
}

enum ReviewStatus {
  REVIEWED
  WARNING
  BLOCKED
}

model User {
  id              String              @id @default(cuid())
  name            String
  username        String              @unique
  email           String              @unique
  passwordHash    String?
  avatarUrl       String?
  bio             String?
  repositories    Repository[]
  versionAuthors  RepositoryVersion[] @relation("VersionAuthor")
  stars           Star[]
  cloneEvents     Clone[]             @relation("CloneActor")
  downloads       Download[]
  sessions        Session[]
  workspaces      Workspace[]
  llmConfigs      UserLlmConfig[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id           String       @id @default(cuid())
  name         String       @unique
  slug         String       @unique
  repositories Repository[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Repository {
  id                   String               @id @default(cuid())
  ownerId              String
  categoryId           String
  name                 String
  slug                 String
  description          String
  kind                 RepositoryKind       @default(PROMPT_TEXT)
  imageStyle           String?
  customModelNamesJson String?
  visibility           Visibility           @default(PUBLIC)
  sourceMode           RepositorySourceMode @default(MANUAL)
  reviewStatus         ReviewStatus         @default(REVIEWED)
  reviewScore          Int                  @default(0)
  reviewSummary        String?
  reviewFlagsJson      String?
  reviewDetailsJson    String?
  reviewedAt           DateTime?
  latestVersionId      String?              @unique
  starsCount           Int                  @default(0)
  clonesCount          Int                  @default(0)
  downloadsCount       Int                  @default(0)
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category             Category             @relation(fields: [categoryId], references: [id])
  versions             RepositoryVersion[]  @relation("RepositoryVersions")
  latestVersion        RepositoryVersion?   @relation("LatestRepositoryVersion", fields: [latestVersionId], references: [id])
  tags                 RepositoryTag[]
  compatibility        RepositoryCompatibility[]
  assets               RepositoryAsset[]
  chunks               RepositoryChunk[]
  stars                Star[]
  sourceClones         Clone[]              @relation("SourceRepository")
  derivedClones        Clone[]              @relation("ClonedRepository")
  downloads            Download[]
  workspaceLinks       WorkspaceRepository[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([ownerId, slug])
  @@index([categoryId])
  @@index([kind])
}

model RepositoryVersion {
  id                 String      @id @default(cuid())
  repositoryId       String
  createdById        String
  versionNumber      String
  title              String
  shortDescription   String
  systemPrompt       String
  userPromptTemplate String
  variablesJson      String
  outputFormat       String
  notes              String?
  changelog          String
  isLatest           Boolean     @default(false)
  repository         Repository  @relation("RepositoryVersions", fields: [repositoryId], references: [id], onDelete: Cascade)
  createdBy          User        @relation("VersionAuthor", fields: [createdById], references: [id])
  selectedByLatestOf Repository? @relation("LatestRepositoryVersion")
  chunks             RepositoryChunk[]
  createdAt          DateTime    @default(now())

  @@unique([repositoryId, versionNumber])
  @@index([repositoryId, createdAt])
}

model RepositoryAsset {
  id           String          @id @default(cuid())
  repositoryId String
  originalName String
  relativePath String?
  storagePath  String
  mimeType     String?
  sizeBytes    Int
  isText       Boolean         @default(false)
  previewText  String?
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunks       RepositoryChunk[]
  createdAt    DateTime        @default(now())

  @@index([repositoryId])
}

model RepositoryChunk {
  id            String             @id @default(cuid())
  repositoryId  String
  assetId       String?
  versionId     String?
  sourceType    String
  title         String
  content       String
  contentHash   String
  embeddingJson String?
  repository    Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  asset         RepositoryAsset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  version       RepositoryVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([repositoryId])
  @@index([assetId])
  @@index([versionId])
}

model Tag {
  id           String          @id @default(cuid())
  name         String          @unique
  slug         String          @unique
  repositories RepositoryTag[]
  createdAt    DateTime        @default(now())
}

model RepositoryTag {
  repositoryId String
  tagId        String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([repositoryId, tagId])
  @@index([tagId])
}

model RepositoryCompatibility {
  repositoryId String
  target       CompatibilityTarget
  repository   Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([repositoryId, target])
  @@index([target])
}

model UserLlmConfig {
  id        String      @id @default(cuid())
  userId    String
  provider  LlmProvider
  label     String?
  apiKey    String
  model     String
  baseUrl   String?
  isEnabled Boolean     @default(true)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@unique([userId, provider, model])
}

model Workspace {
  id          String                @id @default(cuid())
  ownerId     String
  name        String
  description String?
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       WorkspaceRepository[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId])
  @@unique([ownerId, name])
}

model WorkspaceRepository {
  workspaceId  String
  repositoryId String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([workspaceId, repositoryId])
  @@index([repositoryId])
}

model Star {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, repositoryId])
  @@index([repositoryId])
}

model Clone {
  id                 String     @id @default(cuid())
  sourceRepositoryId String
  clonedRepositoryId String
  userId             String
  createdAt          DateTime   @default(now())
  sourceRepository   Repository @relation("SourceRepository", fields: [sourceRepositoryId], references: [id], onDelete: Cascade)
  clonedRepository   Repository @relation("ClonedRepository", fields: [clonedRepositoryId], references: [id], onDelete: Cascade)
  user               User       @relation("CloneActor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sourceRepositoryId])
  @@index([clonedRepositoryId])
  @@index([userId])
}

model Download {
  id           String     @id @default(cuid())
  repositoryId String
  userId       String?
  format       String
  createdAt    DateTime   @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([userId])
}
